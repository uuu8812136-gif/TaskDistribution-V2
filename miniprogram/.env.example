# HBuilderX/uni-app Vue 3 (Vite) variables.
# Development defaults to http://127.0.0.1:18099/api when this is empty.
VITE_API_BASE_URL=

# Optional. When empty, this is derived by removing /api from the API URL.
VITE_UPLOAD_BASE_URL=

# Legacy webpack aliases are also accepted when an older HBuilderX compiler is used:
# VUE_APP_API_BASE_URL=http://127.0.0.1:18099/api
# VUE_APP_UPLOAD_BASE_URL=http://127.0.0.1:18099
