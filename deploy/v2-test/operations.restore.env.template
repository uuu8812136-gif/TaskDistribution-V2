# Copy outside the repository to a root-owned 0600/0640 file before use.
# RESTORE_DATABASE and the database path in RESTORE_MONGODB_URI must be identical.
BACKUP_VOLUME_ROOT=/mnt/taskdistribution-v2-test-backup
BACKUP_ROOT=/mnt/taskdistribution-v2-test-backup/backups
UPLOAD_PATH=/srv/taskdistribution-v2-test/taskdistribution-v2/uploads
BACKUP_ALLOW_REMOTE=false
BACKUP_LOG_PATH=/mnt/taskdistribution-v2-test-backup/backups/operations.jsonl

RESTORE_ROOT=/srv/taskdistribution-v2-test/restore-drills
RESTORE_DATABASE=customer_acceptance_rollback_YYYYMMDD_v2_test
RESTORE_MONGODB_URI=mongodb://127.0.0.1:27150/customer_acceptance_rollback_YYYYMMDD_v2_test?replicaSet=customer_acceptance_v2_rs
MONGORESTORE_PATH=/usr/bin/mongorestore
MONGORESTORE_SHA256=REPLACE_WITH_APPROVED_BINARY_SHA256
