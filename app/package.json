{
  "name": "task-distribution-backend",
  "version": "1.0.0",
  "description": "任务分配管理系统后端",
  "main": "server.js",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 ../tests/backend/**/*.test.js",
    "test:unit": "node --test --test-concurrency=1 ../tests/backend/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 ../tests/backend/integration/*.test.js",
    "seed": "node seed.js",
    "init": "node init-db.js",
    "init:clear": "node init-db.js --clear",
    "check": "node check-db.js",
    "migrate:legacy-tenant": "node script/migrateLegacyTenant.js",
    "migrate:task-review-stages": "node script/migrateTaskReviewStages.js",
    "migrate:transport-master-data": "node script/backfillTransportMasterData.js",
    "migrate:position-levels": "node script/migratePositionLevels.js",
    "migrate:equipment-category-index": "node script/migrateEquipmentCategoryIndex.js",
    "import:customer-test-data": "node script/importCustomerRealTestData.js",
    "import:customer-attendance-test-data": "node script/importCustomerAttendanceTestData.js",
    "cleanup:equipment-imports": "node script/cleanupEquipmentImportPreviews.js",
    "cleanup:temporary-files": "node script/cleanupTemporaryFiles.js",
    "repair:equipment-messages": "node script/repairEquipmentMessages.js",
    "provision:developer-account": "node script/provisionDeveloperAccount.js",
    "provision:readonly-demo": "node script/provisionReadOnlyDemoAccount.js",
    "verify:super-admin": "node script/verifySuperAdminRetention.js",
    "seed:v2-demo": "node script/seedV2Demo.js",
    "start:v2-e2e": "node script/startV2LocalE2E.js"
  },
  "keywords": ["task", "management", "express", "mongodb"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.2",
    "mongoose": "^8.24.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^2.2.0",
    "exceljs": "4.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "express-validator": "^7.0.1",
    "fast-xml-parser": "^5.10.1"
  },
  "overrides": {
    "brace-expansion": "^1.1.16",
    "lodash": "^4.18.1",
    "minimatch": "^3.1.5",
    "path-to-regexp": "^0.1.13",
    "picomatch": "^2.3.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "nodemon": "^3.0.2"
  }
}
