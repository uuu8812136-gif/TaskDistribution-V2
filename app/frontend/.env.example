# Keep real deployment addresses in an untracked .env.local file or CI secrets.
# Development may leave this empty and use /api through VITE_DEV_PROXY_TARGET.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:18099

# Optional comma-separated hostnames used only by the Vite development server.
VITE_DEV_ALLOWED_HOSTS=
