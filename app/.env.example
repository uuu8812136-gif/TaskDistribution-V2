APP_ENV=development
NODE_ENV=development
APP_INSTANCE=task-distribution-v2-dev
PORT=18099
API_BIND_HOST=127.0.0.1
# Routine rule, record, reading, photo, and audit writes require transactions.
# Initialize this MongoDB node as a replica set before starting the API.
MONGODB_URI=mongodb://127.0.0.1:27017/task_distribution_v2_dev?replicaSet=task_distribution_v2_rs
JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE=8h
JWT_ISSUER=task-distribution-v2
JWT_AUDIENCE=task-distribution-v2-clients
UPLOAD_PATH=../.test-data/uploads
MAX_FILE_SIZE=10485760
TEMPORARY_FILE_USER_MAX_COUNT=20
TEMPORARY_FILE_USER_MAX_BYTES=104857600
TEMPORARY_FILE_TEAM_MAX_COUNT=200
TEMPORARY_FILE_TEAM_MAX_BYTES=1073741824
TEMPORARY_FILE_TTL_HOURS=24
CORS_ORIGINS=http://localhost:3101
ENABLE_LEGACY_PUBLIC_UPLOADS=false
EQUIPMENT_ROUTINE_WORKER_ENABLED=false
EQUIPMENT_ROUTINE_WORKER_INTERVAL_MS=300000
# WeChat Mini Program subscription messages shown in WeChat "Service Notifications".
# Keep the AppSecret only in the server's restricted environment file.
WECHAT_SERVICE_NOTIFICATION_ENABLED=false
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_SERVICE_NOTIFICATION_TEMPLATE_ID=
WECHAT_SERVICE_NOTIFICATION_PAGE=pages/message/index
WECHAT_SERVICE_NOTIFICATION_ACTIVATED_AT=
WECHAT_SERVICE_NOTIFICATION_WORKER_INTERVAL_MS=30000
# Acceptance-only override. Both switches are required; leave disabled in production.
ACCEPTANCE_TEST_MODE=false
ACCEPTANCE_TIME_BYPASS_USERNAMES=
ACCEPTANCE_TIME_BYPASS_EXPIRES_AT=
