APP_ENV=development
NODE_ENV=development
APP_INSTANCE=task-distribution-v2-dev
PORT=18099
MONGODB_URI=mongodb://127.0.0.1:27017/task_distribution_v2_dev
JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE=8h
JWT_ISSUER=task-distribution-v2
JWT_AUDIENCE=task-distribution-v2-clients
UPLOAD_PATH=../.test-data/uploads
MAX_FILE_SIZE=10485760
CORS_ORIGINS=http://localhost:3101
ENABLE_LEGACY_PUBLIC_UPLOADS=false
