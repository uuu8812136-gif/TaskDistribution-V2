# Store the real file outside the repository and restrict it to the operations account.
BACKUP_VOLUME_ROOT=E:\TaskDistribution-V2-BackupVolume
BACKUP_ROOT=E:\TaskDistribution-V2-BackupVolume\backups
UPLOAD_PATH=E:\TaskDistribution-V2-State\uploads
BACKUP_LOG_PATH=E:\TaskDistribution-V2-BackupVolume\logs\operations.jsonl
MONGODB_URI=mongodb://127.0.0.1:27017/task_distribution_v2
MONGODUMP_PATH=E:\MongoDB-Tools\bin\mongodump.exe
MONGODUMP_SHA256=
MONGORESTORE_PATH=E:\MongoDB-Tools\bin\mongorestore.exe
MONGORESTORE_SHA256=
BACKUP_ALLOW_REMOTE=false
# --oplog is only valid for full-instance dumps, not this configured single database dump.
BACKUP_USE_OPLOG=false
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
BACKUP_WEEKLY_DAY=0

# Restore drills are isolated from both active uploads and backup storage.
RESTORE_ROOT=E:\TaskDistribution-V2-RestoreDrills
RESTORE_MONGODB_URI=mongodb://127.0.0.1:27017/task_distribution_restore_test
RESTORE_DATABASE=task_distribution_restore_test

HEALTH_API_URL=http://127.0.0.1:18099/health
HEALTH_WEB_URL=http://127.0.0.1:3101/
HEALTH_API_PORT=18099
HEALTH_WEB_PORT=3101
HEALTH_MONGO_PORT=27017
HEALTH_API_LOG_PATH=E:\TaskDistribution-V2-Logs\api.log
HEALTH_WEB_LOG_PATH=E:\TaskDistribution-V2-Logs\web.log
HEALTH_BACKUP_MAX_AGE_HOURS=26
HEALTH_DISK_MIN_FREE_GB=10
HEALTH_INTERVAL_SECONDS=30
